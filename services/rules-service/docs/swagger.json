    "definitions": {
        "application.CreateRuleRequest": {
            "type": "object",
            "properties": {
                "action_id": {
                    "type": "string"
                },
                "action_type": {
                    "$ref": "#/definitions/domain.ActionType"
                },
                "name": {
                    "type": "string"
                },
                "trigger_id": {
                    "type": "string"
                },
                "trigger_threshold": {
                    "description": "Para light_low: considerar luz baixa abaixo deste % (0 = usar 30)",
                    "type": "number"
                },
                "trigger_type": {
                    "$ref": "#/definitions/domain.TriggerType"
                }
            }
        },
        "domain.ActionType": {
            "type": "string",
            "enum": [
                "turn_on_light",
                "turn_off_light",
                "trigger_alarm"
            ],
            "x-enum-varnames": [
                "ActionTurnOnLight",
                "ActionTurnOffLight",
                "ActionTriggerAlarm"
            ]
        },
        "domain.TriggerType": {
            "type": "string",
            "enum": [
                "motion",
                "light_low",
                "light_high",
                "schedule"
            ],
            "x-enum-varnames": [
                "TriggerMotion",
                "TriggerLight",
                "TriggerLightHigh",
                "TriggerSchedule"
            ]
